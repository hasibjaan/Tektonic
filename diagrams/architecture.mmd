%% Architecture diagram — Mermaid source. FIRST DRAFT from the Phase 1 design.
%% Nothing here is implemented yet. "planned:" names the file where it will live.
%% Compaction order is NOT frozen until Phase 7; it is shown as a placeholder.
flowchart TD

  subgraph CLIENTS["Clients"]
    CLI["kvdb.py commands<br/>open put get del batch dump check"]
    SERVE["kvdb.py serve<br/>reader thread + ThreadPoolExecutor (≥2)<br/>stdout under a lock, flush every line"]
  end

  subgraph ENGINE["Engine — src/kv (planned)"]
    API["Client API — db.py<br/>open · put · get · delete · batch · compact · close"]
    LOCK{{"ONE global lock<br/>threading.Lock<br/>held by put/delete/batch, get, compact, close"}}
    GUARD["Disk-full guard — db.py<br/>end + txn size ≤ max_bytes ?<br/>else SizeCapReached, file untouched"]
    WP["Write path — db.py<br/>ONE path for put, delete, batch"]
    ENC["Layout — layout.py<br/>encode / decode, Struct '#lt;...', zlib.crc32"]
    IDX[("In-memory index — dict<br/>key bytes → (value_offset #lt;#lt; 21) | value_length")]
    REC["Recovery — recovery.py<br/>scan, cut torn tail, restore trailer; check (read-only)"]
    COMP["Compaction — db.py (Phase 7, order not frozen)"]
    PAUSE["Pause points — pause.py<br/>KVDB_PAUSE_AT"]
  end

  subgraph DISK["Disk — one data file"]
    WH["write handle<br/>r+b, buffering=0"]
    RH["read handle<br/>rb, buffering=0, used by get"]
    FILE[("data file")]
  end

  CLI --> API
  SERVE --> API
  API --> LOCK
  LOCK --> GUARD --> WP --> ENC
  WP --> WH --> FILE
  API -- get --> IDX
  IDX -- offset, length --> RH --> FILE
  API -- open --> REC --> FILE
  REC -- rebuilds --> IDX
  API -- compact --> COMP --> FILE
  PAUSE -.-> WP
  PAUSE -.-> REC
  PAUSE -.-> COMP

  subgraph LAYOUT["On-disk layout — little-endian, sizes in bytes"]
    L0["File header 16<br/>magic 'KVDB' 4 · version 2 = 1 · flags 2 = 0 · max_bytes 8"]
    L1["Txn header 3<br/>type 1 = 0xA1 · op_count 2 (1–10,000)"]
    L2["Each op 7 + key + value<br/>op 1 (1 put, 2 del) · key_len 2 (1–1,024) · val_len 4 (0–1,048,576) · key · value"]
    L3["Commit marker 16<br/>magic 'CMIT' 4 · body_len 8 · crc32 4 over txn header + ops"]
    L4["Trailer 1 = 0xEE"]
    L0 --> L1 --> L2 --> L3 --> L4
    L4 -- next transaction --> L1
  end

  subgraph WRITE["Write order — numbered (CLAUDE.md §9)"]
    W0["take the global lock"]
    W1["1 validate everything, incl. cap → error = file untouched"]
    W2["2 remember end offset E"]
    W3["3 seek E, write txn header + ops (loop)"]
    W4["4 os.fsync — body on disk"]
    W5["5 write commit marker + trailer (loop)"]
    W6["6 os.fsync — COMMITTED"]
    W7["7 apply ops to dict in list order"]
    W8["8 release lock, return → ACK + flush"]
    WX["error in 3–6: truncate to E, os.fsync, raise<br/>truncate fails → database failed"]
    W0 --> W1 --> W2 --> W3 --> W4 --> W5 --> W6 --> W7 --> W8
    W3 -.-> WX
    W4 -.-> WX
    W5 -.-> WX
    W6 -.-> WX
  end

  subgraph RECOVERY["Recovery flow — open (CLAUDE.md §10)"]
    R0["open file"]
    R1{"exists?"}
    R1N["create header, fsync file + dir"]
    R2{"≥ 16 bytes?"}
    R2S{"prefix of a valid header?"}
    R2F["fresh header, fsync"]
    R3{"magic KVDB, version 1, flags 0?"}
    RNO["refuse: NotOurFile — untouched"]
    R4["scan transactions from 16<br/>stage ops, apply only after a valid marker"]
    R5{"how did the scan stop?"}
    RT["TORN: ftruncate to absolute offset, fsync"]
    RM["TRAILER MISSING: write 0xEE, fsync"]
    RC["CORRUPT: refuse — untouched"]
    RH2["half-done compaction: Phase 7"]
    RR["ready: report keys, ms, bytes cut, trailer restored"]
    R0 --> R1
    R1 -- no --> R1N --> RR
    R1 -- yes --> R2
    R2 -- no --> R2S
    R2S -- yes --> R2F --> RR
    R2S -- no --> RNO
    R2 -- yes --> R3
    R3 -- no --> RNO
    R3 -- yes --> RH2 --> R4 --> R5
    R5 -- clean end --> RR
    R5 -- torn tail --> RT --> RR
    R5 -- ends at a marker --> RM --> RR
    R5 -- bad byte --> RC
  end
